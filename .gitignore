# Pretrained weights are downloaded by Ultralytics when training
/weights/

# Keep only frozen experiment evidence and the validated checkpoint
/runs/*
!/runs/helmet/
!/runs/evaluation/
/runs/helmet/*
!/runs/helmet/yolo26n_100e_b8_20261015_145934/
